{
  "name": "startup-chuno", "private": true, "version": "1.0.0", "type": "module",
  "workspaces": ["services/*", "frontend", "infrastructure/sandbox"],
  "scripts": {
    "generate": "node scripts/prisma.mjs generate",
    "migrate": "node scripts/prisma.mjs migrate deploy",
    "seed": "node scripts/seed.mjs",
    "build": "npm run build --workspace frontend",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.19.0", "bcryptjs": "3.0.2", "decimal.js": "10.6.0",
    "express": "5.1.0", "express-rate-limit": "8.2.1", "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2", "swagger-ui-express": "5.0.1", "zod": "3.25.76"
  },
  "devDependencies": {"prisma": "6.19.0", "@playwright/test": "1.56.1"}
}
